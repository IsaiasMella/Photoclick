---
/**
 * 404.astro — Página de error (= 404.html del original).
 *
 * Astro la compila a /404.html, que es lo que sirven por defecto los hosts
 * estáticos (Netlify, Vercel, Cloudflare Pages, GitHub Pages) ante una ruta
 * inexistente. Lleva `noindex` para que los buscadores no la indexen.
 */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/global/PageHeader.astro';
import errorImage from '@/assets/images/404-error-img.png';
import { routes } from '@/data/site';
---

<BaseLayout title="Page Not Found" description="The page you are looking for does not exist." noindex>
  {/* El original tenía "found " con un espacio final dentro del span; no se ve. */}
  <PageHeader title="Page not" accent="found" crumbs={[{ label: '404 Error Page' }]} />

  <div class="error-page">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="error-page-image wow fadeInUp">
            <Image src={errorImage} alt="Illustration of a photographer taking pictures of a newlywed couple" loading="eager" />
          </div>
          <div class="error-page-content">
            <div class="section-title">
              <h2 class="text-anime-style-2" data-cursor="-opaque">Oops! page <span>not found</span></h2>
            </div>
            <div class="error-page-content-body">
              <p class="wow fadeInUp" data-wow-delay="0.2s">The page you are looking for does not exist</p>
              <a class="btn-default wow fadeInUp" data-wow-delay="0.4s" href={routes.home}>Back to Homepage</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

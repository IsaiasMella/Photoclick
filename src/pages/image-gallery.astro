---
/**
 * image-gallery.astro — Galería de fotos (= image-gallery.html del original).
 *
 * - Fotos: colección `gallery` con `album === 'photos'`, ordenadas por `order`.
 * - `.gallery-items` es lo que engancha el lightbox (src/scripts/lightbox.ts,
 *   Agente D): delega en los <a> y abre su `href`. Ese `href` apunta a una
 *   versión WebP optimizada a 1200 px (antes, el JPG original).
 * - Miniaturas: 3 columnas en ≥992 px y 2 debajo (col-lg-4 col-6).
 * - Delay de aparición: 0.2s × índice, como el original (hasta 1.6s).
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/global/PageHeader.astro';
import { galleryAlt } from '@/components/ui/gallery-alt';
import { delay } from '@/lib/wow';

const photos = (await getCollection('gallery', (e) => e.data.album === 'photos')).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Versión grande que abre el lightbox. */
const items = await Promise.all(
  photos.map(async (p) => ({
    image: p.data.image,
    full: (await getImage({ src: p.data.image, width: Math.min(1200, p.data.image.width), format: 'webp' })).src,
  })),
);
---

<BaseLayout title="Image Gallery" description="A selection of our favourite wedding photographs.">
  <PageHeader title="Our" accent="gallery" crumbs={[{ label: 'Gallery' }]} />

  <div class="page-gallery">
    <div class="container">
      <div class="row gallery-items page-gallery-box">
        {
          items.map((item, i) => (
            <div class="col-lg-4 col-6">
              <div class="photo-gallery wow fadeInUp" data-wow-delay={delay(i)}>
                <a href={item.full} data-cursor-text="View">
                  <figure class="image-anime">
                    <Image
                      src={item.image}
                      alt={galleryAlt(item.image)}
                      widths={[300, 450, 600, 900]}
                      sizes="(max-width: 991px) 50vw, 416px"
                    />
                  </figure>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '@/scripts/lightbox';
</script>

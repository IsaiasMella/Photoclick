---
/**
 * CtaBox.astro — Llamado a la acción con foto de fondo en parallax
 * (.cta-box.parallaxie).
 *
 * Se usa en: las 3 home. Sin props.
 *
 * Decisiones:
 *   - Fondo optimizado (D9): backgroundImageStyle('cta', …) genera
 *     --cta-bg-image(-sm) en AVIF/WebP; el CSS ya las usa.
 *   - Teléfono desde site.ts.
 *   - Las 3 caras de clientes son las fotos de los 3 primeros testimonios
 *     (el original usa author-1..3.jpg, las mismas).
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { backgroundImageStyle } from '@/lib/background-image';
import { routes, site } from '@/data/site';
import ctaBg from '@/assets/images/cta-box-bg-image.jpg';

const style = await backgroundImageStyle('cta', ctaBg, { mobile: false }) // sin background-size: cover → tamaño natural;
const clients = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<div class="cta-box parallaxie" style={style}>
  <div class="container">
    <div class="row">
      <div class="col-xl-12">
        <div class="cta-box-content">
          <div class="section-title">
            <span class="section-sub-title wow fadeInUp">Contact Us Today</span>
            <h2 class="text-anime-style-2" data-cursor="-opaque">Preserve your wedding moments with <span>stunning photography today</span></h2>
            <p class="wow fadeInUp" data-wow-delay="0.2s">
              Your wedding day is filled with once-in-a-lifetime moments that deserve to be captured with care and creativity. Our expert team is dedicated to preserving every emotion.
            </p>
          </div>

          <div class="cta-contact-list wow fadeInUp" data-wow-delay="0.4s">
            <ul>
              <li>Get Your Quote or Call : <a href={site.contact.phoneHref}>{site.contact.phone}</a></li>
            </ul>
          </div>

          <div class="cta-content-footer wow fadeInUp" data-wow-delay="0.6s">
            <div class="cta-content-btn">
              <a href={routes.contact} class="btn-default">Book Consultation</a>
            </div>

            <div class="cta-client-box">
              <div class="satisfy-client-images">
                {
                  clients.map((c) => (
                    <div class="satisfy-client-image">
                      <figure class="image-anime">
                        <Image src={c.data.avatar} alt={c.data.name} />
                      </figure>
                    </div>
                  ))
                }
              </div>

              <div class="cta-client-content">
                <p>“5K+ Client satisfaction rate with our great results.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

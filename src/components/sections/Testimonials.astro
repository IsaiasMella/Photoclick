---
/**
 * Testimonials.astro — Slider de testimonios (.our-testimonials).
 *
 * Se usa en: las 3 home, /about y /services (idéntica).
 *
 * Props:
 *   limit — cuántos testimonios entran al slider (default 4, como el
 *           original), de la colección `testimonials` ordenada por `order`.
 *
 * El Swiper lo inicia src/scripts/sliders.ts (engancha
 * .testimonial-slider .swiper). Sin JS se ve la primera fila de tarjetas.
 * Cada tarjeta es cards/TestimonialItem sin animación de entrada
 * (animate=false), como en el original.
 */
import { getCollection } from 'astro:content';
import TestimonialItem from '@/components/cards/TestimonialItem.astro';
import { routes } from '@/data/site';

interface Props {
  limit?: number;
}

const { limit = 4 } = Astro.props;
const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order).slice(0, limit);
---

<div class="our-testimonials">
  <div class="container">
    <div class="row section-row">
      <div class="col-lg-12">
        <div class="section-title section-title-center">
          <span class="section-sub-title wow fadeInUp">Testimonials</span>
          <h2 class="text-anime-style-2" data-cursor="-opaque">Client love and <span>happy moments</span></h2>
          <p class="wow fadeInUp" data-wow-delay="0.2s">
            We are grateful to be part of so many beautiful love stories. Every smile, every emotion, and every heartfelt moment shared by our clients reflects the trust.
          </p>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-lg-12">
        <div class="testimonial-slider">
          <div class="swiper">
            <div class="swiper-wrapper" data-cursor-text="Drag">
              {
                testimonials.map((entry, i) => (
                  <div class="swiper-slide">
                    <TestimonialItem entry={entry} index={i} />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-12">
        <div class="section-footer-text wow fadeInUp" data-wow-delay="0.2s">
          <p><span>Free</span>Let's connect and make your wedding moments truly unforgettable - <a href={routes.testimonials}>View all reviews.</a></p>
        </div>
      </div>
    </div>
  </div>
</div>

---
/**
 * Hero.astro — Portada de las tres home (.hero).
 *
 * Se usa en: / (variant="image"), /index-slider/ (variant="slider") y
 * /index-video/ (variant="video").
 *
 * Props:
 *   variant — 'image' | 'slider' | 'video' (obligatoria).
 *     image  → .hero.parallaxie con la foto de fondo por CSS (optimizada con
 *              backgroundImageStyle → --hero-bg-image, decisión D9).
 *     slider → .hero.hero-slider-layout.parallaxie + .hero-image-slider con 3
 *              fotos en un Swiper con fundido (lo inicia src/scripts/sliders.ts).
 *     video  → .hero.hero-video con un <video> de fondo en autoplay (D8: es el
 *              único video que carga al inicio).
 *
 * Decisiones:
 *   - En la variante video también se pasa el fondo optimizado: el CSS de
 *     .hero siempre pide hero-bg-image.jpg (el video lo tapa). Así, mientras
 *     el video carga, se ve la versión AVIF/WebP en vez de bajar el JPG
 *     original sin optimizar.
 *   - El <h1> lleva data-wow-delay="0.2s" solo en la variante image (así
 *     está en el original; no tiene efecto visible, se conserva igual).
 *   - Primera foto del slider: loading eager + fetchpriority high (es el LCP).
 *   - Círculo "Book your date": loading eager. Está en la primera pantalla y su
 *     CSS (width: 100% dentro de un <a> inline-block) hace que la caja mida 0
 *     hasta que llega el SVG: con lazy, el texto del hero saltaba 74 px
 *     (CLS 0,044 en Lighthouse).
 *   - El video del hero suma playsinline (sin él, iOS lo abre a pantalla
 *     completa); no cambia el aspecto.
 *   - El círculo "Book your date" es una imagen dentro de un enlace: su alt
 *     es el nombre del enlace.
 */
import { Image } from 'astro:assets';
import { backgroundImageStyle } from '@/lib/background-image';
import { routes } from '@/data/site';
import heroBg from '@/assets/images/hero-bg-image.jpg';
import heroBg2 from '@/assets/images/hero-bg-image-2.jpg';
import heroBg3 from '@/assets/images/hero-bg-image-3.jpg';
import bookCircle from '@/assets/images/book-your-date-circle.svg';

interface Props {
  variant: 'image' | 'slider' | 'video';
}

const { variant } = Astro.props;

const slides = [
  { src: heroBg, alt: 'Bride and groom embracing on their wedding day' },
  { src: heroBg2, alt: 'Wedding couple portrait outdoors' },
  { src: heroBg3, alt: 'Newlyweds sharing a romantic moment' },
];

const style = variant === 'slider' ? undefined : await backgroundImageStyle('hero', heroBg);
const classes = {
  image: 'hero parallaxie',
  slider: 'hero hero-slider-layout parallaxie',
  video: 'hero hero-video',
}[variant];
import PreloadBackground from '@/components/global/PreloadBackground.astro';
---

{style && <PreloadBackground src={heroBg} />}
<div class={classes} style={style}>
  {
    variant === 'slider' && (
      <div class="hero-image-slider">
        <div class="swiper">
          <div class="swiper-wrapper">
            {slides.map((s, i) => (
              <div class="swiper-slide">
                <div class="hero-slider-img">
                  <figure>
                    <Image
                      src={s.src}
                      alt={s.alt}
                      widths={[828, 1280, 1920]}
                      sizes="100vw"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : undefined}
                    />
                  </figure>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    )
  }
  {
    variant === 'video' && (
      <div class="hero-bg-video">
        <video autoplay muted loop playsinline id="myVideo">
          <source src="/videos/photoclick-hero-video.mp4" type="video/mp4" />
        </video>
      </div>
    )
  }
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="hero-content">
          <div class="section-title">
            <span class="section-sub-title wow fadeInUp">Pure love, perfectly captured</span>
            <h1 class="text-anime-style-2" data-wow-delay={variant === 'image' ? '0.2s' : undefined} data-cursor="-opaque">Turning your wedding <span>into lasting memories</span></h1>
          </div>

          <div class="book-your-date-circle">
            <a href={routes.contact}><Image src={bookCircle} alt="Book your date" loading="eager" /></a>
          </div>
        </div>
      </div>

      <div class="col-lg-12">
        <div class="hero-content-list wow fadeInUp" data-wow-delay="0.2s">
          <ul>
            <li>Wedding Photographers</li>
            <li>High-Quality Edited Images</li>
            <li>Pre-Wedding & Event Coverage</li>
            <li>Fast & Reliable Delivery</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
